rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'company', 'place', 'machines', 'quote', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.company is string
        && request.resource.data.place is string
        && request.resource.data.machines is string
        && request.resource.data.quote is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.company.size() >= 2
        && request.resource.data.place.size() >= 2
        && request.resource.data.machines.size() >= 2
        && request.resource.data.quote.size() >= 10
        && request.resource.data.quote.size() <= 1000;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
